
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ADMIN_URL=admin/
ALLOWED_HOSTS=actorconnect.example.com
CSRF_TRUSTED_ORIGINS=https://actorconnect.example.com


DATABASE_URL=postgres://actorconnect:actorconnect@db:5432/actorconnect
REDIS_URL=redis://redis:6379/0

CELERY_EAGER=false

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=ActorConnect <no-reply@actorconnect.example.com>

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
WHISPER_MODEL_SIZE=base

RATE_LIMIT_TRUST_XFF=false